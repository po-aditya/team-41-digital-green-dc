{
  "channel": "whatsapp",
  "how_it_arrives": "Days after the chat, so outside WhatsApp's 24-hour reply window. The first message must be an approved template; the questions follow once the farmer taps Start.",
  "opening_template": {
    "messaging_product": "whatsapp",
    "to": "<farmer WhatsApp number>",
    "type": "template",
    "template": {
      "name": "mel_survey_invite",
      "language": {
        "code": "en"
      },
      "components": [
        {
          "type": "button",
          "sub_type": "quick_reply",
          "index": "0",
          "parameters": [
            {
              "type": "payload",
              "payload": "S-20931|start"
            }
          ]
        },
        {
          "type": "button",
          "sub_type": "quick_reply",
          "index": "1",
          "parameters": [
            {
              "type": "payload",
              "payload": "S-20931|later"
            }
          ]
        }
      ]
    }
  },
  "template_text_for_approval": {
    "body": "A short question from FarmerChat about the advice you got. It takes one minute.",
    "quick_replies": [
      "Start",
      "Not now"
    ]
  },
  "messages": [
    {
      "messaging_product": "whatsapp",
      "to": "<farmer WhatsApp number>",
      "type": "interactive",
      "interactive": {
        "type": "button",
        "body": {
          "text": "Did you spray your mustard for the aphids (small green insects)?"
        },
        "action": {
          "buttons": [
            {
              "type": "reply",
              "reply": {
                "id": "S-20931|q1|yes",
                "title": "Yes"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-20931|q1|no",
                "title": "No"
              }
            }
          ]
        }
      }
    },
    {
      "messaging_product": "whatsapp",
      "to": "<farmer WhatsApp number>",
      "type": "interactive",
      "interactive": {
        "type": "button",
        "body": {
          "text": "Was it easy to get the spray?"
        },
        "action": {
          "buttons": [
            {
              "type": "reply",
              "reply": {
                "id": "S-20931|q2|easy",
                "title": "Yes, easily"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-20931|q2|hard",
                "title": "Yes, with difficulty"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-20931|q2|not_found",
                "title": "Could not get it"
              }
            }
          ]
        }
      }
    },
    {
      "messaging_product": "whatsapp",
      "to": "<farmer WhatsApp number>",
      "type": "interactive",
      "interactive": {
        "type": "list",
        "body": {
          "text": "How many of these insects are on the plants now?"
        },
        "action": {
          "button": "Choose",
          "sections": [
            {
              "title": "Choose one",
              "rows": [
                {
                  "id": "S-20931|q3|almost_none",
                  "title": "Almost none"
                },
                {
                  "id": "S-20931|q3|fewer",
                  "title": "Fewer than before"
                },
                {
                  "id": "S-20931|q3|same",
                  "title": "Same as before"
                },
                {
                  "id": "S-20931|q3|more",
                  "title": "More than before"
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
