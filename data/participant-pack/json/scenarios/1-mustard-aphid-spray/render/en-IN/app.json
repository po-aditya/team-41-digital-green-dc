{
  "channel": "app",
  "how_it_arrives": "A notification tells the farmer there is a short question. Tapping it opens the app with the sheet. If they open the app another way inside the send window, the sheet opens then. It never covers an answer that is still arriving, a message being typed, or a call.",
  "presentation": {
    "type": "bottom_sheet",
    "opens_when": [
      "push_tapped",
      "next_app_open"
    ],
    "waits_for": [
      "answer_finished_streaming",
      "no_typing_for_5_seconds",
      "no_call_in_progress"
    ],
    "one_question_per_step": true,
    "steps_total": 3,
    "can_skip": true,
    "can_close": true,
    "swipe_down_closes": true
  },
  "sheet": {
    "title": "A quick question about the advice you got",
    "skip_label": "Skip",
    "close_label": "Close",
    "thank_you": "Thank you. Your answers help us give better advice.",
    "steps": [
      {
        "step": 1,
        "step_label": "1 of 3",
        "item_id": "q1",
        "question_type": "survey-confirm",
        "question": "Did you spray your mustard for the aphids (small green insects)?",
        "options": [
          {
            "label": "Yes",
            "answer": "yes"
          },
          {
            "label": "No",
            "answer": "no"
          }
        ]
      },
      {
        "step": 2,
        "step_label": "2 of 3",
        "item_id": "q2",
        "question_type": "survey-single-select",
        "question": "Was it easy to get the spray?",
        "options": [
          {
            "label": "Yes, easily",
            "answer": "easy"
          },
          {
            "label": "Yes, with difficulty",
            "answer": "hard"
          },
          {
            "label": "Could not get it",
            "answer": "not_found"
          }
        ]
      },
      {
        "step": 3,
        "step_label": "3 of 3",
        "item_id": "q3",
        "question_type": "survey-single-select",
        "question": "How many of these insects are on the plants now?",
        "options": [
          {
            "label": "Almost none",
            "answer": "almost_none"
          },
          {
            "label": "Fewer than before",
            "answer": "fewer"
          },
          {
            "label": "Same as before",
            "answer": "same"
          },
          {
            "label": "More than before",
            "answer": "more"
          }
        ]
      }
    ]
  }
}
