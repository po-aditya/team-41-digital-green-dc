{
  "channel": "app",
  "how_it_arrives": "A notification tells the farmer there is a short question. Tapping it opens the app with the sheet. If they open the app another way inside the send window, the sheet opens then. It never covers an answer that is still arriving, a message being typed, or a call.",
  "presentation": {
    "type": "bottom_sheet",
    "opens_when": [
      "push_tapped",
      "next_app_open"
    ],
    "waits_for": [
      "answer_finished_streaming",
      "no_typing_for_5_seconds",
      "no_call_in_progress"
    ],
    "one_question_per_step": true,
    "steps_total": 2,
    "can_skip": true,
    "can_close": true,
    "swipe_down_closes": true
  },
  "sheet": {
    "title": "A quick question about the advice you got",
    "skip_label": "Skip",
    "close_label": "Close",
    "thank_you": "Thank you. Your answers help us give better advice.",
    "steps": [
      {
        "step": 1,
        "step_label": "1 of 2",
        "item_id": "q1",
        "question_type": "survey-single-select",
        "question": "Did you give the first irrigation to your wheat?",
        "options": [
          {
            "label": "Yes, on time",
            "answer": "on_time"
          },
          {
            "label": "Yes, but later",
            "answer": "late"
          },
          {
            "label": "Not yet",
            "answer": "not_yet"
          }
        ]
      },
      {
        "step": 2,
        "step_label": "2 of 2",
        "item_id": "q2",
        "question_type": "survey-single-select",
        "question": "How does your wheat crop look now?",
        "options": [
          {
            "label": "Green and healthy",
            "answer": "healthy"
          },
          {
            "label": "Some yellow leaves",
            "answer": "some_yellow"
          },
          {
            "label": "Many yellow leaves",
            "answer": "many_yellow"
          }
        ]
      }
    ]
  }
}
