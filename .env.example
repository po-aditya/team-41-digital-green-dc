# Copy to .env and adjust. Never put AWS keys in this file:
# boto3 picks credentials up from your shell, ~/.aws, SSO or an IAM role.

MEL_APP_ENV=dev
MEL_LOG_LEVEL=INFO

# Defaults to ../mel-survey-agent-participant-pack/participant-pack
# MEL_PARTICIPANT_PACK_DIR=/path/to/participant-pack

# MEL_DATABASE_URL=sqlite:///./var/mel.db

# Bedrock. REQUIRED for any Bedrock call: no region is assumed by the code.
# Lookup order: MEL_BEDROCK_REGION, then AWS_REGION, then AWS_DEFAULT_REGION.
MEL_BEDROCK_REGION=us-west-2
MEL_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
MEL_BEDROCK_MAX_TOKENS=1024
# Total requests per call INCLUDING the first (3 = 1 try + 2 retries).
MEL_BEDROCK_TOTAL_MAX_ATTEMPTS=3
# Leave unset to use the model's default temperature.
# MEL_BEDROCK_TEMPERATURE=0.2

# Spending controls (USD). Stop threshold must be <= max.
MEL_BUDGET_MAX_USD=250
MEL_BUDGET_STOP_USD=225
# MEL_PRICING_FILE=config/bedrock_pricing.json
