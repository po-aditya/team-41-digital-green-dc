# Copy to .env and adjust. Never put AWS keys in this file:
# boto3 picks credentials up from your shell, ~/.aws, SSO or an IAM role.

MEL_APP_ENV=dev
MEL_LOG_LEVEL=INFO

# Defaults to ../mel-survey-agent-participant-pack/participant-pack
# MEL_PARTICIPANT_PACK_DIR=/path/to/participant-pack

# MEL_DATABASE_URL=sqlite:///./var/mel.db

# Bedrock. REQUIRED for any Bedrock call: no region is assumed by the code.
# Lookup order: MEL_BEDROCK_REGION, then AWS_REGION, then AWS_DEFAULT_REGION.
MEL_BEDROCK_REGION=us-west-2
MEL_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
MEL_BEDROCK_MAX_TOKENS=1024
# Total requests per call INCLUDING the first (3 = 1 try + 2 retries).
MEL_BEDROCK_TOTAL_MAX_ATTEMPTS=3
# Leave unset to use the model's default temperature.
# MEL_BEDROCK_TEMPERATURE=0.2

# Spending controls (USD). Stop threshold must be <= max.
MEL_BUDGET_MAX_USD=250
MEL_BUDGET_STOP_USD=225
# MEL_PRICING_FILE=config/bedrock_pricing.json

# --- MVP phases ---------------------------------------------------------
# Paid inference is OFF unless this is true. The budget ledger refuses otherwise.
MEL_ALLOW_PAID_INFERENCE=false
# "template" (free, deterministic) or "bedrock" (needs the flag above and budget headroom).
MEL_GENERATION_PROVIDER=template
MEL_GENERATION_MAX_ATTEMPTS=2
MEL_GENERATION_FALLBACK_TO_TEMPLATE=true
MEL_MIN_RELEVANCE_SCORE=0.5
# Model-written question wording: false = refused; true = stored as pending_approval, never scheduled.
MEL_GENERATION_ALLOW_FREEFORM=false
# Real-time lease (seconds) on a generation claim; a crashed worker's claim can be taken over after it.
MEL_GENERATION_LEASE_SECONDS=300
# Paid Bedrock calls: SDK transport retries are always disabled; these are explicit, separately reserved attempts.
MEL_BEDROCK_PAID_APP_ATTEMPTS=2
MEL_BEDROCK_PAID_RETRY_AFTER_TIMEOUT=false
# No new paid attempt while this many reservations are unresolved (billing unknown) until reconciled.
MEL_BUDGET_MAX_UNRESOLVED=3
# Reservation estimate: chars per token (lower = more conservative) and safety multiplier.
MEL_BUDGET_CHARS_PER_TOKEN=3.0
MEL_BUDGET_SAFETY_FACTOR=1.25
# Simulation
MEL_SIMULATION_SEED=20261104
MEL_BROADCASTER_MAX_ATTEMPTS_PER_CHANNEL=3

# --- Operator access (API) ------------------------------------------------
# Required by every route except /healthz; sent as the X-Operator-Token header.
# At least 16 characters. Unset = protected routes answer 503. Generate one, never commit it.
# MEL_OPERATOR_TOKEN=change-me-to-a-long-random-value
