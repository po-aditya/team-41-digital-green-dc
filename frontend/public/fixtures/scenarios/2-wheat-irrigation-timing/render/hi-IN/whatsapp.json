            {
              "type": "reply",
              "reply": {
                "id": "S-21044|q2|some_yellow",
                "title": "कुछ पत्ते पीले"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21044|q2|many_yellow",
                "title": "बहुत पत्ते पीले"
              }
            }
          ]
        }
      }
    }
  ]
