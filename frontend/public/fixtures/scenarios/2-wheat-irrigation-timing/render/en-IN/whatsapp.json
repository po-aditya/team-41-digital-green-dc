{
  "channel": "whatsapp",
  "how_it_arrives": "Days after the chat, so outside WhatsApp's 24-hour reply window. The first message must be an approved template; the questions follow once the farmer taps Start.",
  "opening_template": {
    "messaging_product": "whatsapp",
    "to": "<farmer WhatsApp number>",
    "type": "template",
    "template": {
      "name": "mel_survey_invite",
      "language": {
        "code": "en"
      },
      "components": [
        {
          "type": "button",
          "sub_type": "quick_reply",
          "index": "0",
          "parameters": [
            {
              "type": "payload",
              "payload": "S-21044|start"
            }
          ]
        },
        {
          "type": "button",
          "sub_type": "quick_reply",
          "index": "1",
          "parameters": [
            {
              "type": "payload",
              "payload": "S-21044|later"
            }
          ]
        }
      ]
    }
  },
  "template_text_for_approval": {
    "body": "A short question from FarmerChat about the advice you got. It takes one minute.",
    "quick_replies": [
      "Start",
      "Not now"
    ]
  },
  "messages": [
    {
      "messaging_product": "whatsapp",
      "to": "<farmer WhatsApp number>",
      "type": "interactive",
      "interactive": {
        "type": "button",
        "body": {
          "text": "Did you give the first irrigation to your wheat?"
        },
        "action": {
          "buttons": [
            {
              "type": "reply",
              "reply": {
                "id": "S-21044|q1|on_time",
                "title": "Yes, on time"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21044|q1|late",
                "title": "Yes, but later"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21044|q1|not_yet",
                "title": "Not yet"
              }
            }
          ]
        }
      }
    },
    {
      "messaging_product": "whatsapp",
      "to": "<farmer WhatsApp number>",
      "type": "interactive",
      "interactive": {
        "type": "button",
        "body": {
          "text": "How does your wheat crop look now?"
        },
        "action": {
          "buttons": [
            {
              "type": "reply",
              "reply": {
                "id": "S-21044|q2|healthy",
                "title": "Green and healthy"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21044|q2|some_yellow",
                "title": "Some yellow leaves"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21044|q2|many_yellow",
                "title": "Many yellow leaves"
              }
            }
          ]
        }
      }
    }
  ]
}
