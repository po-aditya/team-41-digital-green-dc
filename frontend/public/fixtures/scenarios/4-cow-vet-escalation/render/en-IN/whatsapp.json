{
  "channel": "whatsapp",
  "how_it_arrives": "Days after the chat, so outside WhatsApp's 24-hour reply window. The first message must be an approved template; the questions follow once the farmer taps Start.",
  "opening_template": {
    "messaging_product": "whatsapp",
    "to": "<farmer WhatsApp number>",
    "type": "template",
    "template": {
      "name": "mel_survey_invite",
      "language": {
        "code": "en"
      },
      "components": [
        {
          "type": "button",
          "sub_type": "quick_reply",
          "index": "0",
          "parameters": [
            {
              "type": "payload",
              "payload": "S-21102|start"
            }
          ]
        },
        {
          "type": "button",
          "sub_type": "quick_reply",
          "index": "1",
          "parameters": [
            {
              "type": "payload",
              "payload": "S-21102|later"
            }
          ]
        }
      ]
    }
  },
  "template_text_for_approval": {
    "body": "A short question from FarmerChat about the advice you got. It takes one minute.",
    "quick_replies": [
      "Start",
      "Not now"
    ]
  },
  "messages": [
    {
      "messaging_product": "whatsapp",
      "to": "<farmer WhatsApp number>",
      "type": "interactive",
      "interactive": {
        "type": "button",
        "body": {
          "text": "Did a vet see your cow?"
        },
        "action": {
          "buttons": [
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q1|yes",
                "title": "Yes"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q1|no",
                "title": "No"
              }
            }
          ]
        }
      }
    },
    {
      "messaging_product": "whatsapp",
      "to": "<farmer WhatsApp number>",
      "type": "interactive",
      "interactive": {
        "type": "button",
        "body": {
          "text": "How is your cow now?"
        },
        "action": {
          "buttons": [
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q2|better",
                "title": "Better"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q2|same",
                "title": "Same as before"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q2|worse",
                "title": "Worse"
              }
            }
          ]
        }
      }
    }
  ]
}
