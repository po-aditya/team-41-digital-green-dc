{
  "channel": "whatsapp",
  "how_it_arrives": "Days after the chat, so outside WhatsApp's 24-hour reply window. The first message must be an approved template; the questions follow once the farmer taps Start.",
  "opening_template": {
    "messaging_product": "whatsapp",
    "to": "<farmer WhatsApp number>",
    "type": "template",
    "template": {
      "name": "mel_survey_invite",
      "language": {
        "code": "hi"
      },
      "components": [
        {
          "type": "button",
          "sub_type": "quick_reply",
          "index": "0",
          "parameters": [
            {
              "type": "payload",
              "payload": "S-21102|start"
            }
          ]
        },
        {
          "type": "button",
          "sub_type": "quick_reply",
          "index": "1",
          "parameters": [
            {
              "type": "payload",
              "payload": "S-21102|later"
            }
          ]
        }
      ]
    }
  },
  "template_text_for_approval": {
    "body": "आपको मिली सलाह के बारे में FarmerChat से एक छोटा सवाल। बस एक मिनट लगेगा।",
    "quick_replies": [
      "शुरू करें",
      "अभी नहीं"
    ]
  },
  "messages": [
    {
      "messaging_product": "whatsapp",
      "to": "<farmer WhatsApp number>",
      "type": "interactive",
      "interactive": {
        "type": "button",
        "body": {
          "text": "क्या पशु डॉक्टर ने आपकी गाय को देखा?"
        },
        "action": {
          "buttons": [
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q1|yes",
                "title": "हाँ"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q1|no",
                "title": "नहीं"
              }
            }
          ]
        }
      }
    },
    {
      "messaging_product": "whatsapp",
      "to": "<farmer WhatsApp number>",
      "type": "interactive",
      "interactive": {
        "type": "button",
        "body": {
          "text": "आपकी गाय अब कैसी है?"
        },
        "action": {
          "buttons": [
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q2|better",
                "title": "पहले से ठीक"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q2|same",
                "title": "पहले जैसी"
              }
            },
            {
              "type": "reply",
              "reply": {
                "id": "S-21102|q2|worse",
                "title": "पहले से खराब"
              }
            }
          ]
        }
      }
    }
  ]
}
